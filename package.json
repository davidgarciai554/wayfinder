{
  "name": "@davidgarciai554/wayfinder",
  "version": "0.1.0",
  "description": "Personal Markdown task manager that Claude Code uses as a project tracker and memory: MCP server, local web board and Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wayfinder": "dist/wayfinder.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
